{
	// ═══════════════════════════════════════════════════════════════════
	// OpenExplorer Provider & Model Registry
	//
	// This is the single source of truth for all provider/model metadata.
	// The TypeScript provider-registry.ts loads this at runtime.
	//
	// Schema per provider:
	//   id              — unique slug used in CLI flags (e.g. --provider openrouter)
	//   displayName     — human-friendly name shown in wizards and logs
	//   baseUrl         — API root URL
	//   apiFormat        — "openai" | "anthropic" | "ollama" — wire format
	//   envVar          — primary env var for the API key
	//   envVarAliases   — alternate env var names (checked as fallbacks)
	//   free            — true | false | "limited"
	//   website         — provider dashboard / signup URL
	//   needsApiKey     — true if an API key is required (ollama = false)
	//   canValidate     — true if the provider exposes a /models endpoint
	//   modelIdFormat   — "full" = org/model (openrouter), "provider-prefix" = bare id
	//   modelPrefixes   — prefixes used by inferProvider to guess the provider
	//   isPrimary       — shown first in the setup wizard
	//   authStyle       — "bearer" | "x-api-key" | "none"
	//   localProvider   — only for ollama: probe URL + preferred models
	//   models[]        — array of model entries
	//
	// Schema per model:
	//   id                  — exact model ID sent in API requests
	//   displayName         — human-friendly name
	//   contextWindow       — max context tokens
	//   inputPricePer1M     — USD per 1M input tokens
	//   outputPricePer1M    — USD per 1M output tokens
	//   supportsReasoning   — model supports chain-of-thought / reasoning
	//   supportsToolCalling — model supports function/tool calling
	//   aliases[]           — short names for --model flag
	// ═══════════════════════════════════════════════════════════════════

	// ─── Providers ────────────────────────────────────────────────────
	"providers": [
		// ── OpenRouter ─────────────────────────────────────────────────
		// Aggregator: routes to 200+ models via a single API key.
		// Model IDs use "org/model" format (e.g. "anthropic/claude-sonnet-4.6").
		{
			"id": "openrouter",
			"displayName": "OpenRouter",
			"baseUrl": "https://openrouter.ai/api/v1",
			"apiFormat": "openai",
			"envVar": "OPENROUTER_API_KEY",
			"envVarAliases": ["OPENEXPLORER_OPENROUTER_KEY"],
			"free": "limited",
			"website": "https://openrouter.ai",
			"needsApiKey": true,
			"canValidate": true,
			"modelIdFormat": "full",
			"modelPrefixes": [
				"llama",
				"mistral",
				"qwen",
				"phi",
				"meta-llama",
				"x-ai"
			],
			"isPrimary": true,
			"authStyle": "bearer",
			"models": [
				{
					"id": "anthropic/claude-sonnet-4.6",
					"displayName": "Claude Sonnet 4.6",
