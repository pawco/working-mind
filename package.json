{
  "name": "wmind",
  "version": "0.0.1",
  "description": "Terminal AI agent with persistent knowledge graph (v0.0.1 dev — expect breaking changes)",
  "type": "module",
  "bin": {
    "wmind": "./bin/wmind.cjs"
  },
  "files": [
    "bin/wmind.cjs",
    "dist/cli.cjs",
    "dist/index.mjs",
    "dist/tui.mjs",
    "packs/starter/",
    "data/",
    "install.sh"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:binaries": "bun scripts/build-binaries.mjs",
    "dev": "bun run src/index.ts",
    "gen-schema": "npx tsx scripts/gen-pack-schema.ts",
    "start": "node dist/cli.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src/",
    "postinstall": "node scripts/install-binary.mjs",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "terminal",
    "cli",
    "knowledge-graph",
    "mcp",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pawco/working-brain.git"
  },
  "bugs": {
    "url": "https://github.com/pawco/working-brain/issues"
  },
  "homepage": "https://workingmind.ai",
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "wmind-darwin-arm64": "0.0.1",
    "wmind-darwin-x64": "0.0.1",
    "wmind-linux-arm64": "0.0.1",
    "wmind-linux-x64": "0.0.1",
    "wmind-windows-x64": "0.0.1"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentui/core": "^0.2.3",
    "@opentui/react": "^0.2.3",
    "commander": "^14.0.3",
    "execa": "^9.5.0",
    "highlight.js": "^11.11.1",
    "markdansi": "^0.2.1",
    "openai": "^6.36.0",
    "picocolors": "^1.0.0",
    "react": "^19.2.6",
    "strip-json-comments": "^5.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.1",
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
